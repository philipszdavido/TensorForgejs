{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "declaration": true,
    "types": ["node"],
    "forceConsistentCasingInFileNames": true
  },
  "exclude": ["image", "dist", "docs", "test", "ui", "src/tests"],
  "include": ["src/**/*"]
}
